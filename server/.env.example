MONGO_URI=mongodb://localhost:27017/cadenza
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:5173
# Scores microservice (leaderboard). Leave SCORES_SERVICE_URL empty to run
# without it: the leaderboard then shows "unavailable" and everything else works.
SCORES_SERVICE_URL=http://localhost:4000
# Must match SCORES_API_KEY in scores-service/.env
SCORES_API_KEY=change-me
